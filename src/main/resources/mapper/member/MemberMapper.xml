<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticketo.member.mapper.MemberMapper">

    <!-- password는 의도적으로 제외 -->
    <sql id="memberColumns">
        id, email, name, created_at
    </sql>

    <select id="selectMemberList" resultType="com.ticketo.member.vo.MemberVO">
        SELECT <include refid="memberColumns"/>
        FROM member
        ORDER BY id DESC
    </select>

    <select id="selectMemberById" resultType="com.ticketo.member.vo.MemberVO">
        SELECT <include refid="memberColumns"/>
        FROM member
        WHERE id = #{id}
    </select>

    <!-- 로그인 검증 전용: password(BCrypt 해시)를 포함해 조회 -->
    <select id="selectMemberForLoginByEmail" resultType="com.ticketo.member.vo.MemberVO">
        SELECT id, email, password, name, created_at
        FROM member
        WHERE email = #{email}
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM member WHERE email = #{email})
    </select>

    <insert id="insertMember" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (email, password, name)
        VALUES (#{email}, #{password}, #{name})
    </insert>
</mapper>
